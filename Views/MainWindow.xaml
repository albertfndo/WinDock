<Window x:Class="WinDock.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:WinDock.Converters"
        mc:Ignorable="d"
        Title="WinDock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Height="140"
        AllowDrop="True"
        DragEnter="OnDockDragEnter"
        DragOver="OnDockDragOver"
        Drop="OnDockDrop">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <conv:GreaterThanZeroToVisibilityConverter x:Key="MultiCountToVis" />
        <conv:DoubleToCornerRadiusConverter x:Key="RadiusConverter" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="BadgeVisConverter" />

        <!-- Tooltip Style -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#E60F172A" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#000000" Opacity="0.4" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- System Button Style -->
        <Style x:Key="TrayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#25FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reusable Dock Item Template for Pinned & Running Apps -->
        <DataTemplate x:Key="DockItemTemplate">
            <Grid Width="{Binding ItemWidth}" Height="{Binding ItemHeight}" Margin="3,0,3,0"
                  Cursor="Hand"
                  MouseLeftButtonUp="OnItemClick"
                  MouseRightButtonUp="OnItemRightClick"
                  Background="Transparent">

                <!-- Fluid Upward Magnification -->
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                </Grid.RenderTransform>
                <Grid.RenderTransformOrigin>
                    <Point X="0.5" Y="0.85" />
                </Grid.RenderTransformOrigin>

                <!-- Icon and Badge Grid -->
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,5">
                    <!-- Crisp High-Resolution Icon -->
                    <Image Source="{Binding Icon}"
                           Width="{Binding IconSize}"
                           Height="{Binding IconSize}"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           RenderOptions.EdgeMode="Aliased"
                           SnapsToDevicePixels="True"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Color="#000000" Opacity="0.35" />
                        </Image.Effect>
                    </Image>

                    <!-- Red Notification / Window Count Badge -->
                    <Border Visibility="{Binding BadgeText, Converter={StaticResource BadgeVisConverter}}"
                            Background="#EF4444"
                            CornerRadius="9"
                            MinWidth="18"
                            Height="18"
                            Padding="4,1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-4,-6,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.4" />
                        </Border.Effect>
                        <TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="9.5" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Running Indicator Dot -->
                <Border Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                        Width="5"
                        Height="5"
                        CornerRadius="2.5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#94A3B8" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Background" Value="#38BDF8" />
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="6" Color="#38BDF8" ShadowDepth="0" Opacity="0.9" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- macOS Floating Tooltip Bubble -->
        <Border x:Name="MacTooltipBubble"
                Grid.Row="0"
                Opacity="0"
                IsHitTestVisible="False"
                Background="#E60F172A"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="0,0,0,6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.5" />
            </Border.Effect>
            <TextBlock x:Name="MacTooltipText"
                       Text="App Title"
                       Foreground="#F8FAFC"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" />
        </Border>

        <!-- Floating Dock Bar -->
        <Border x:Name="DockBar"
                Grid.Row="1"
                Height="78"
                CornerRadius="28"
                BorderThickness="1"
                BorderBrush="#40FFFFFF"
                Padding="10,4"
                HorizontalAlignment="Center"
                ClipToBounds="False"
                MouseEnter="OnDockMouseEnter"
                MouseLeave="OnDockMouseLeave">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E60F172A" Offset="0.0" />
                    <GradientStop Color="#F0020617" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.6" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- 1. Start Menu Button (Launchpad, Settings & Power) -->
                <Button Style="{StaticResource TrayButtonStyle}"
                        Click="OnStartButtonClicked"
                        ToolTip="Applications, Settings &amp; Power Menu (Launchpad)"
                        Margin="2,0,4,0">
                    <Grid Width="38" Height="38">
                        <Border Background="#2038BDF8" CornerRadius="11" BorderBrush="#4038BDF8" BorderThickness="1">
                            <!-- Windows 4-square modern icon -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="18" Height="18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="2" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Background="#38BDF8" CornerRadius="1.5" />
                                <Border Grid.Row="0" Grid.Column="2" Background="#38BDF8" CornerRadius="1.5" />
                                <Border Grid.Row="2" Grid.Column="0" Background="#38BDF8" CornerRadius="1.5" />
                                <Border Grid.Row="2" Grid.Column="2" Background="#38BDF8" CornerRadius="1.5" />
                            </Grid>
                        </Border>
                    </Grid>
                </Button>

                <!-- Left Divider -->
                <Rectangle Width="1" Height="28" Fill="#30FFFFFF" Margin="4,0,6,0" VerticalAlignment="Center" />

                <!-- 2. Pinned Application Icons -->
                <ItemsControl x:Name="PinnedItemsControl"
                              ItemTemplate="{StaticResource DockItemTemplate}"
                              PreviewMouseMove="OnDockItemsMouseMove">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Divider between Pinned Apps and Running Apps -->
                <Rectangle x:Name="RunningDivider"
                           Width="1" Height="28" Fill="#30FFFFFF" Margin="6,0,6,0"
                           VerticalAlignment="Center" />

                <!-- 3. Running (Unpinned) Application Icons -->
                <ItemsControl x:Name="RunningItemsControl"
                              ItemTemplate="{StaticResource DockItemTemplate}"
                              PreviewMouseMove="OnDockItemsMouseMove">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Right Divider -->
                <Rectangle Width="1" Height="28" Fill="#30FFFFFF" Margin="6,0,6,0" VerticalAlignment="Center" />

                <!-- 4. System Widgets: Network, Volume, Clock, Show Desktop -->

                <!-- Network Status Widget -->
                <Button x:Name="BtnNetwork"
                        Style="{StaticResource TrayButtonStyle}"
                        Click="OnNetworkClicked"
                        ToolTip="Network Status (Click for Settings)"
                        Margin="2,0">
                    <Grid Width="26" Height="26">
                        <!-- Wi-Fi Icon -->
                        <Path x:Name="PathWifi"
                              Data="M12 4C7.31 4 3.07 5.9 0 8.98L12 21 24 8.98C20.93 5.9 16.69 4 12 4zm0 3.5c3.8 0 7.26 1.48 9.87 3.91L12 19.3 2.13 11.41C4.74 8.98 8.2 7.5 12 7.5z"
                              Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <!-- Ethernet Icon -->
                        <Path x:Name="PathEthernet" Visibility="Collapsed"
                              Data="M7.77 6.76L6.23 5.48.82 12l5.41 6.52 1.54-1.28L3.42 12l4.35-5.24zM7 13h2v-2H7v2zm10-2h-2v2h2v-2zm-6 2h2v-2h-2v2zm5.23-7.52l-1.54 1.28L19.04 12l-4.35 5.24 1.54 1.28L21.64 12l-5.41-6.52z"
                              Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <!-- Disconnected Icon -->
                        <Path x:Name="PathOffline" Visibility="Collapsed"
                              Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8 0-1.85.63-3.55 1.69-4.9L16.9 18.31C15.55 19.37 13.85 20 12 20zm6.31-3.1L7.1 5.69C8.45 4.63 10.15 4 12 4c4.42 0 8 3.58 8 8 0 1.85-.63 3.55-1.69 4.9z"
                              Fill="#EF4444" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <!-- Volume Control Widget (Click: Mute, Scroll: Volume Up/Down) -->
                <Button x:Name="BtnVolume"
                        Style="{StaticResource TrayButtonStyle}"
                        Click="OnVolumeClicked"
                        MouseWheel="OnVolumeMouseWheel"
                        ToolTip="Volume: Scroll to Adjust, Click to Mute"
                        Margin="2,0">
                    <Grid Width="26" Height="26">
                        <Path x:Name="PathVolumeNormal"
                              Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"
                              Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Path x:Name="PathVolumeMuted" Visibility="Collapsed"
                              Data="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27l4.73 4.73H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"
                              Fill="#EF4444" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <!-- Digital Clock Widget (Jam & Tanggal) -->
                <Button Style="{StaticResource TrayButtonStyle}"
                        Click="OnClockClicked"
                        ToolTip="Clock &amp; Calendar"
                        Margin="4,0,2,0">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock x:Name="ClockText"
                                   Text="12:00"
                                   Foreground="#F1F5F9"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="DateText"
                                   Text="Wed, Oct 21"
                                   Foreground="#94A3B8"
                                   FontSize="9"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Show Desktop Button (Kembali ke Desktop) -->
                <Button Style="{StaticResource TrayButtonStyle}"
                        Click="OnShowDesktopClicked"
                        ToolTip="Show Desktop (Kembali ke Desktop / Minimize All)"
                        Margin="2,0,2,0">
                    <Grid Width="24" Height="26">
                        <Path Data="M20 3H4c-1.1 0-2 .9-2 2v11c0 1.1.9 2 2 2h6l-2 2v1h8v-1l-2-2h6c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 13H4V5h16v11z"
                              Fill="#94A3B8" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>
