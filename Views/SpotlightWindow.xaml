<Window x:Class="WinDock.Views.SpotlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:WinDock.Converters"
        mc:Ignorable="d"
        Title="WinDock Spotlight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="680"
        Height="460"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Deactivated="OnWindowDeactivated">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- ListBoxItem Selection Style -->
        <Style x:Key="SpotlightItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="12,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#3038BDF8" />
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#6038BDF8" />
                                <Setter TargetName="itemBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#15FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Spotlight Container -->
    <Grid VerticalAlignment="Top" Margin="10,20,10,10">
        <Border CornerRadius="20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F00F172A" Offset="0.0" />
                    <GradientStop Color="#F8080C16" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#45FFFFFF" Offset="0.0" />
                    <GradientStop Color="#18FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>1</Border.BorderThickness>

            <Border.Effect>
                <DropShadowEffect BlurRadius="48" ShadowDepth="12" Direction="270" Color="#000000" Opacity="0.75" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Spotlight Search Input Bar -->
                <Grid Grid.Row="0" Margin="16,14,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Magnifying Glass Icon -->
                    <Path Grid.Column="0"
                          Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                          Fill="#38BDF8" Width="22" Height="22" Stretch="Uniform"
                          VerticalAlignment="Center" Margin="2,0,12,0" />

                    <!-- Search Input Box -->
                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#F8FAFC"
                             CaretBrush="#38BDF8"
                             FontSize="18"
                             FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                             FontWeight="Normal"
                             VerticalAlignment="Center"
                             TextChanged="OnSearchTextChanged"
                             PreviewKeyDown="OnSearchBoxKeyDown" />

                    <!-- Watermark / Placeholder Text -->
                    <TextBlock x:Name="SearchPlaceholder"
                               Grid.Column="1"
                               Text="Spotlight Search, apps, running windows, calculations..."
                               Foreground="#64748B"
                               FontSize="18"
                               FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center" />

                    <!-- Escape Badge -->
                    <Border Grid.Column="2"
                            Background="#20FFFFFF"
                            CornerRadius="6"
                            Padding="6,2"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                        <TextBlock Text="esc" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <!-- Separator -->
                <Rectangle Grid.Row="1" Fill="#20FFFFFF" Height="1" />

                <!-- 2. Results List -->
                <Grid Grid.Row="2" Margin="10,8,10,8" MinHeight="260">
                    <ListBox x:Name="ResultsList"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ItemContainerStyle="{StaticResource SpotlightItemStyle}"
                             MouseDoubleClick="OnResultDoubleClicked"
                             SelectionChanged="OnResultSelectionChanged">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Item Icon or Fallback Symbol -->
                                    <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <!-- Real Icon if present -->
                                        <Image Source="{Binding Icon}"
                                               Visibility="{Binding Icon, Converter={StaticResource NullToVis}}"
                                               Width="32" Height="32"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                                        <!-- Fallback placeholder if no icon -->
                                        <Border Visibility="{Binding Icon, Converter={StaticResource NullToVis}, ConverterParameter=invert}"
                                                Background="#25FFFFFF" CornerRadius="8">
                                            <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Center: Title & Subtitle -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#F8FAFC"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Foreground="#94A3B8"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Right: Category Badge & Return Hint -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <!-- Category Tag -->
                                        <Border CornerRadius="6"
                                                Padding="7,2"
                                                Margin="0,0,8,0">
                                            <Border.Background>
                                                <SolidColorBrush Color="#20FFFFFF" />
                                            </Border.Background>
                                            <TextBlock Text="{Binding CategoryDisplay}"
                                                       Foreground="#CBD5E1"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold" />
                                        </Border>

                                        <!-- Enter return hint -->
                                        <Border Background="#2038BDF8"
                                                CornerRadius="6"
                                                Padding="6,2">
                                            <TextBlock Text="↵ Return"
                                                       Foreground="#38BDF8"
                                                       FontSize="10.5"
                                                       FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- 3. Bottom Footer Status -->
                <Grid Grid.Row="3" Margin="16,0,16,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Tip: Type math like " Foreground="#64748B" FontSize="10.5" />
                        <TextBlock Text="45 * 12 + 10" Foreground="#38BDF8" FontSize="10.5" FontWeight="SemiBold" />
                        <TextBlock Text=" or search running windows and apps" Foreground="#64748B" FontSize="10.5" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Navigate: ↑ ↓   Open: ↵   Close: esc   Help: F1" Foreground="#64748B" FontSize="10.5" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
