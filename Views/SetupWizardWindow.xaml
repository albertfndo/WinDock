<Window x:Class="WinDock.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WinDock Setup Wizard"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="580"
        Height="540"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="WizardButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F50F172A"
            BorderBrush="#38455C"
            BorderThickness="1"
            CornerRadius="18"
            Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.75" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="14" Height="14" CornerRadius="7" Background="#38BDF8" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#38BDF8" ShadowDepth="0" Opacity="0.9" />
                        </Border.Effect>
                    </Border>
                    <TextBlock Text="WinDock Setup &amp; Personalization Wizard" Foreground="#F8FAFC" FontSize="17" FontWeight="Bold" />
                </StackPanel>

                <Button Content="✕" Click="OnCancelClicked"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="14" Cursor="Hand" />
            </Grid>

            <!-- Wizard Pages -->
            <Grid Grid.Row="1">
                <!-- Page 1: Welcome & Taskbar Setup -->
                <StackPanel x:Name="Page1" Visibility="Visible">
                    <TextBlock Text="Step 1 of 2: Taskbar &amp; Screen Integration" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" Margin="0,4,0,12" />
                    <TextBlock Text="Choose how WinDock integrates with your Windows desktop:" Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14" />

                    <Border Background="#1E293B" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <RadioButton x:Name="RbFullReplacement" IsChecked="True" GroupName="ModeGroup" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold">
                                <TextBlock Text="Full Taskbar Replacement (Recommended)" />
                            </RadioButton>
                            <TextBlock Text="Hides the native Windows taskbar and uses WinDock with screen space reservation (AppBar). Seamless macOS experience."
                                       Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="22,4,0,12" />

                            <RadioButton x:Name="RbCompanion" GroupName="ModeGroup" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold">
                                <TextBlock Text="Floating Companion Dock" />
                            </RadioButton>
                            <TextBlock Text="Keeps your Windows taskbar visible or auto-hidden, letting WinDock float smoothly over or above."
                                       Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="22,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="#1E293B" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <CheckBox x:Name="WizardChkNotch" IsChecked="True" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" Content="Enable Dynamic Drop Notch (Top Screen Shelf)" />
                            <TextBlock Text="Drag files, folders, or links to the top edge to hold them temporarily and drag them into any app."
                                       Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="22,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Page 2: Icon Size & Styling (Solid to Glass + Radius) -->
                <StackPanel x:Name="Page2" Visibility="Collapsed">
                    <TextBlock Text="Step 2 of 2: Appearance &amp; Sizing" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" Margin="0,4,0,12" />

                    <!-- Live Mini Preview -->
                    <Border Height="68" Background="#0F172A" CornerRadius="10" Padding="10" Margin="0,0,0,14" BorderBrush="#25FFFFFF" BorderThickness="1">
                        <Border x:Name="WizardPreviewDock" Height="48" Width="240" CornerRadius="24"
                                BorderThickness="1" BorderBrush="#40FFFFFF" Background="#4B5563"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="30" Height="30" CornerRadius="6" Background="#FF5722" Margin="3,0">
                                    <TextBlock Text="🔥" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Width="30" Height="30" CornerRadius="6" Background="#25D366" Margin="3,0">
                                    <TextBlock Text="💬" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Width="30" Height="30" CornerRadius="6" Background="#5865F2" Margin="3,0">
                                    <TextBlock Text="🎮" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Icon Size Slider -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Dock Icon Size" Foreground="#F1F5F9" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="WizardTxtIconSize" Text="52px" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="WizardSliderIconSize" Minimum="36" Maximum="72" Value="52"
                            TickFrequency="2" IsSnapToTickEnabled="True"
                            ValueChanged="OnWizardIconSizeChanged" Margin="0,0,0,12" />

                    <!-- Solid to Glass Slider -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Dock Material (Solid ↔ Glass)" Foreground="#F1F5F9" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="WizardTxtGlass" Text="65% Glass / 35% Solid" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="WizardSliderGlass" Minimum="0.10" Maximum="1.0" Value="0.65"
                            TickFrequency="0.05" IsSnapToTickEnabled="True"
                            ValueChanged="OnWizardGlassChanged" Margin="0,0,0,12" />

                    <!-- Border Radius Slider -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Border Radius (Square ↔ Pill)" Foreground="#F1F5F9" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="WizardTxtRadius" Text="28px (Pill)" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="WizardSliderRadius" Minimum="0" Maximum="40" Value="28"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="OnWizardRadiusChanged" />
                </StackPanel>
            </Grid>

            <!-- Bottom Navigation -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Button x:Name="BtnBack" Content="← Back" Click="OnBackClicked"
                        Background="#334155" Style="{StaticResource WizardButton}"
                        HorizontalAlignment="Left" Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnNext" Content="Next →" Click="OnNextClicked" Style="{StaticResource WizardButton}" />
                    <Button x:Name="BtnFinish" Content="Finish &amp; Start WinDock" Click="OnFinishClicked"
                            Background="#10B981" Style="{StaticResource WizardButton}" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
