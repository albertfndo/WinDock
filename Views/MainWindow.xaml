<Window x:Class="WinDock.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:WinDock.Converters"
        mc:Ignorable="d"
        Title="WinDock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Height="125"
        AllowDrop="True"
        DragEnter="OnDockDragEnter"
        DragOver="OnDockDragOver"
        Drop="OnDockDrop">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <conv:GreaterThanZeroToVisibilityConverter x:Key="MultiCountToVis" />
        <conv:DoubleToCornerRadiusConverter x:Key="RadiusConverter" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="BadgeVisConverter" />

        <!-- Tooltip Style -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#E60F172A" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#000000" Opacity="0.4" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- System Button Style -->
        <Style x:Key="TrayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#25FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- macOS Floating Tooltip Bubble -->
        <Border x:Name="MacTooltipBubble"
                Grid.Row="0"
                Opacity="0"
                IsHitTestVisible="False"
                Background="#E60F172A"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="0,0,0,6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.5" />
            </Border.Effect>
            <TextBlock x:Name="MacTooltipText"
                       Text="App Title"
                       Foreground="#F8FAFC"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" />
        </Border>

        <!-- Floating Dock Border -->
        <Border x:Name="DockBar"
                Grid.Row="1"
                Height="68"
                CornerRadius="24"
                BorderThickness="1"
                BorderBrush="#40FFFFFF"
                Padding="10,6"
                HorizontalAlignment="Center"
                MouseEnter="OnDockMouseEnter"
                MouseLeave="OnDockMouseLeave">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E60F172A" Offset="0.0" />
                    <GradientStop Color="#F0020617" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.6" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- 1. Start Menu Button -->
                <Button Style="{StaticResource TrayButtonStyle}"
                        Click="OnStartButtonClicked"
                        ToolTip="Windows Start Menu"
                        Margin="2,0,4,0">
                    <Grid Width="38" Height="38">
                        <Border Background="#2038BDF8" CornerRadius="10" BorderBrush="#3038BDF8" BorderThickness="1">
                            <!-- Windows 4-square modern icon -->
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="18" Height="18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="2" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Background="#38BDF8" CornerRadius="1.5" />
                                <Border Grid.Row="0" Grid.Column="2" Background="#38BDF8" CornerRadius="1.5" />
                                <Border Grid.Row="2" Grid.Column="0" Background="#38BDF8" CornerRadius="1.5" />
                                <Border Grid.Row="2" Grid.Column="2" Background="#38BDF8" CornerRadius="1.5" />
                            </Grid>
                        </Border>
                    </Grid>
                </Button>

                <!-- Left Divider -->
                <Rectangle Width="1" Height="32" Fill="#30FFFFFF" Margin="4,0,8,0" VerticalAlignment="Center" />

                <!-- 2. Dock Application Icons (Pinned + Running) -->
                <ItemsControl x:Name="DockItemsControl" PreviewMouseMove="OnDockItemsMouseMove">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Dock Icon Item Container -->
                            <Grid Width="{Binding ItemWidth}" Height="{Binding ItemHeight}" Margin="3,0,3,0"
                                  Cursor="Hand"
                                  MouseLeftButtonUp="OnItemClick"
                                  MouseRightButtonUp="OnItemRightClick"
                                  Background="Transparent">

                                <Grid.LayoutTransform>
                                    <ScaleTransform x:Name="ItemScale" ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                                </Grid.LayoutTransform>

                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <!-- App Icon -->
                                    <Image Source="{Binding Icon}"
                                           Width="{Binding IconSize}"
                                           Height="{Binding IconSize}"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                        <Image.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Color="#000000" Opacity="0.4" />
                                        </Image.Effect>
                                    </Image>

                                    <!-- Notification / Window count badge (Red circle like macOS/WhatsApp/Discord) -->
                                    <Border Visibility="{Binding BadgeText, Converter={StaticResource BadgeVisConverter}}"
                                            Background="#EF4444"
                                            CornerRadius="9"
                                            MinWidth="18"
                                            Height="18"
                                            Padding="4,1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,-3,-6,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.4" />
                                        </Border.Effect>
                                        <TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="9.5" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <!-- Bottom Running Indicator Dot -->
                                <Border Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                                        Width="5"
                                        Height="5"
                                        CornerRadius="2.5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- Default Running: Subtle White/Blue Dot -->
                                            <Setter Property="Background" Value="#94A3B8" />
                                            <Style.Triggers>
                                                <!-- Active Focused Window: Bright Cyan Dot with Glow -->
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#38BDF8" />
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="6" Color="#38BDF8" ShadowDepth="0" Opacity="0.9" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Right Divider -->
                <Rectangle Width="1" Height="32" Fill="#30FFFFFF" Margin="8,0,4,0" VerticalAlignment="Center" />

                <!-- 3. System Tray & Controller Widgets -->

                <!-- MacBook-style Spotlight Search Button (Alt + Space) -->
                <Button Style="{StaticResource TrayButtonStyle}"
                        Click="OnSpotlightClicked"
                        ToolTip="Spotlight Search (Alt + Space)"
                        Margin="2,0">
                    <Grid Width="28" Height="28">
                        <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                              Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- Dynamic Notch Drop Shelf Toggle Button -->
                <Button Style="{StaticResource TrayButtonStyle}"
                        Click="OnToggleNotchClicked"
                        ToolTip="Toggle Top Dynamic Drop Notch Shelf"
                        Margin="2,0">
                    <Grid Width="28" Height="28">
                        <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"
                              Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- Windows Taskbar Controller Toggle Button -->
                <Button x:Name="BtnTaskbarToggle"
                        Style="{StaticResource TrayButtonStyle}"
                        Click="OnToggleWindowsTaskbarClicked"
                        ToolTip="Toggle Windows Native Taskbar (Show / Hide)"
                        Margin="2,0">
                    <Grid Width="28" Height="28">
                        <Border x:Name="TaskbarStatusIndicator" Width="20" Height="14" CornerRadius="3"
                                BorderThickness="1.5" BorderBrush="#10B981" Background="#2010B981"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Height="2" Fill="#10B981" VerticalAlignment="Bottom" Margin="1" />
                        </Border>
                    </Grid>
                </Button>

                <!-- Digital Clock Widget -->
                <Button Style="{StaticResource TrayButtonStyle}"
                        Click="OnClockClicked"
                        ToolTip="Clock &amp; Calendar"
                        Margin="4,0,2,0">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock x:Name="ClockText"
                                   Text="12:00"
                                   Foreground="#F1F5F9"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="DateText"
                                   Text="Wed, Oct 21"
                                   Foreground="#94A3B8"
                                   FontSize="9"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Settings Button -->
                <Button Style="{StaticResource TrayButtonStyle}"
                        Click="OnSettingsClicked"
                        ToolTip="WinDock Settings"
                        Margin="2,0,2,0">
                    <Grid Width="26" Height="26">
                        <!-- Modern Cog / Gear Icon -->
                        <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                              Fill="#CBD5E1" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>
