<Window x:Class="WinDock.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:WinDock.Converters"
        mc:Ignorable="d"
        Title="WinDock Dynamic Drop Notch"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="520"
        Height="150"
        AllowDrop="True"
        DragEnter="OnWindowDragEnter"
        DragOver="OnWindowDragOver"
        DragLeave="OnWindowDragLeave"
        Drop="OnWindowDrop">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Glow animations -->
        <Storyboard x:Key="ExpandStoryboard">
            <DoubleAnimation Storyboard.TargetName="NotchContainer"
                             Storyboard.TargetProperty="Height"
                             To="135" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="NotchContainer"
                             Storyboard.TargetProperty="Width"
                             To="480" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="CollapseStoryboard">
            <DoubleAnimation Storyboard.TargetName="NotchContainer"
                             Storyboard.TargetProperty="Height"
                             To="34" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="NotchContainer"
                             Storyboard.TargetProperty="Width"
                             To="180" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid VerticalAlignment="Top" HorizontalAlignment="Center">
        <!-- Main Notch Container -->
        <Border x:Name="NotchContainer"
                Width="180"
                Height="34"
                CornerRadius="0,0,18,18"
                BorderThickness="1,0,1,1"
                BorderBrush="#44FFFFFF"
                MouseEnter="OnNotchMouseEnter"
                MouseLeave="OnNotchMouseLeave"
                MouseLeftButtonDown="OnNotchMouseLeftButtonDown">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#EE0F172A" Offset="0.0" />
                    <GradientStop Color="#F5020617" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55" />
            </Border.Effect>

            <Grid>
                <!-- Compact Pill View (Idle) -->
                <Grid x:Name="CompactView" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Camera / Sensor / Drop Icon dot -->
                        <Border Width="8" Height="8" CornerRadius="4" Background="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" Color="#38BDF8" ShadowDepth="0" Opacity="0.8" />
                            </Border.Effect>
                        </Border>

                        <TextBlock x:Name="NotchStatusText"
                                   Text="Drop Shelf"
                                   Foreground="#E2E8F0"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                   VerticalAlignment="Center" />

                        <!-- Counter badge if items stored -->
                        <Border x:Name="ItemCountBadge"
                                Visibility="Collapsed"
                                Background="#2563EB"
                                CornerRadius="8"
                                Padding="5,1"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="BadgeCountText" Text="0" Foreground="White" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Expanded Drop Shelf View -->
                <Grid x:Name="ExpandedView" Visibility="Collapsed" Margin="12,8,12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="2,0,2,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"
                                  Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Dynamic Drop Shelf" Foreground="#F8FAFC" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text=" • Drag items in or drag them out" Foreground="#94A3B8" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Clear All button -->
                        <Button HorizontalAlignment="Right"
                                Content="Clear All"
                                Click="OnClearAllClicked"
                                Foreground="#F43F5E"
                                Background="#20F43F5E"
                                BorderBrush="#40F43F5E"
                                BorderThickness="1"
                                FontSize="10"
                                Padding="8,2"
                                Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Dropped Items List / Empty State -->
                    <Grid Grid.Row="1">
                        <!-- Empty placeholder -->
                        <Border x:Name="EmptyDropPlaceholder"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Background="#10FFFFFF">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Drag and drop files, apps, or links here"
                                           Foreground="#CBD5E1"
                                           FontSize="11"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Hold them temporarily to move between apps or pin them to Dock"
                                           Foreground="#64748B"
                                           FontSize="9.5"
                                           Margin="0,2,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Items ScrollViewer -->
                        <ScrollViewer x:Name="ItemsScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Visibility="Collapsed">
                            <ItemsControl x:Name="NotchItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="110" Height="68" Margin="0,0,8,0"
                                                Background="#25FFFFFF"
                                                BorderBrush="#33FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="6,4"
                                                Cursor="Hand"
                                                ToolTip="{Binding FilePath}"
                                                MouseMove="OnItemMouseMove"
                                                MouseRightButtonUp="OnItemRightClick">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Top: Icon & Remove button -->
                                                <Grid Grid.Row="0">
                                                    <Image Source="{Binding Icon}" Width="28" Height="28"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Button Content="✕"
                                                            Tag="{Binding}"
                                                            Click="OnRemoveItemClicked"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Background="Transparent" BorderThickness="0"
                                                            Foreground="#94A3B8" FontSize="9" Width="14" Height="14" Cursor="Hand" />
                                                </Grid>

                                                <!-- Bottom: Title & Size -->
                                                <StackPanel Grid.Row="1">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="#F1F5F9"
                                                               FontSize="9.5"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding SizeFormatted}"
                                                               Foreground="#94A3B8"
                                                               FontSize="8"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Bottom Quick Actions -->
                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="📌 Pin to Dock"
                                    Click="OnPinSelectedToDockClicked"
                                    Foreground="#38BDF8"
                                    Background="#1538BDF8"
                                    BorderBrush="#3038BDF8"
                                    BorderThickness="1"
                                    FontSize="9.5"
                                    Padding="6,2"
                                    Margin="0,0,6,0"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4" />
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="📋 Copy Path"
                                    Click="OnCopyPathClicked"
                                    Foreground="#CBD5E1"
                                    Background="#15FFFFFF"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    FontSize="9.5"
                                    Padding="6,2"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="Tip: Drag item out into any app"
                                   Foreground="#64748B"
                                   FontSize="9"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
