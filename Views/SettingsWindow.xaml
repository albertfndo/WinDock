<Window x:Class="WinDock.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WinDock Preferences"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="560"
        Height="640"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="ModernToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,5" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0A84FF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Dialog Window -->
    <Border CornerRadius="18" Padding="22">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FB111115" Offset="0.0" />
                <GradientStop Color="#FD09090C" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#28FFFFFF" Offset="0.0" />
                <GradientStop Color="#10FFFFFF" Offset="1.0" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.BorderThickness>1</Border.BorderThickness>

        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.75" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="12" Height="12" CornerRadius="6" Background="#0A84FF" Margin="0,0,10,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Color="#0A84FF" ShadowDepth="0" Opacity="0.6" />
                        </Border.Effect>
                    </Border>
                    <TextBlock Text="WinDock Preferences" Foreground="#F4F4F5" FontSize="16" FontWeight="Bold" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Shortcuts" Click="OnOpenShortcutsGuideClicked"
                            Background="#1AFFFFFF" Foreground="#E4E4E7" BorderBrush="#26FFFFFF" BorderThickness="1"
                            FontSize="11" FontWeight="SemiBold" Padding="9,3" Cursor="Hand" Margin="0,0,8,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Setup Wizard" Click="OnRunSetupWizardClicked"
                            Background="#1AFFFFFF" Foreground="#E4E4E7" BorderBrush="#26FFFFFF" BorderThickness="1"
                            FontSize="11" FontWeight="SemiBold" Padding="9,3" Cursor="Hand" Margin="0,0,12,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="✕"
                            Click="OnCloseClicked"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Foreground="#71717A"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand" />
                </StackPanel>
            </Grid>

            <!-- Settings Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Section: Style & Appearance -->
                    <TextBlock Text="DOCK MATERIAL &amp; SHAPE" Foreground="#A1A1AA" FontSize="11" FontWeight="Bold" Margin="0,2,0,8" />

                    <Border Background="#16161C" BorderBrush="#22222A" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Live Interactive Preview Box -->
                            <TextBlock Text="Live Preview" Foreground="#A1A1AA" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Border Height="72" Background="#101014" CornerRadius="10" Padding="10" Margin="0,0,0,14" BorderBrush="#1CFFFFFF" BorderThickness="1">
                                <!-- Preview Dock Surface -->
                                <Border x:Name="PreviewDock"
                                        Height="52"
                                        Width="260"
                                        CornerRadius="24"
                                        BorderThickness="1"
                                        BorderBrush="#30FFFFFF"
                                        Padding="12,4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Color="#000000" Opacity="0.5" />
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Mock icon 1 -->
                                        <Border Width="34" Height="34" CornerRadius="8" Background="#FF5722" Margin="4,0">
                                            <TextBlock Text="🔥" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <!-- Mock icon 2 with red notification badge -->
                                        <Grid Width="34" Height="34" Margin="4,0">
                                            <Border CornerRadius="8" Background="#25D366">
                                                <TextBlock Text="💬" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Background="#EF4444" CornerRadius="7" Width="14" Height="14"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0">
                                                <TextBlock Text="6" Foreground="White" FontSize="8.5" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <!-- Mock icon 3 -->
                                        <Border Width="34" Height="34" CornerRadius="8" Background="#5865F2" Margin="4,0">
                                            <TextBlock Text="🎮" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <!-- Mock icon 4 -->
                                        <Border Width="34" Height="34" CornerRadius="8" Background="#4285F4" Margin="4,0">
                                            <TextBlock Text="🌐" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Border>

                            <!-- 1. Solid to Glass Slider -->
                            <Grid Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Dock Style:" Foreground="#F4F4F5" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text=" (Glass / Translucent ←→ Solid Matte)" Foreground="#71717A" FontSize="11" Margin="4,1,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="TxtGlassValue" Text="65% Glass / 35% Solid" Foreground="#0A84FF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="SliderGlassOpacity"
                                    Minimum="0.10" Maximum="1.0" Value="0.65"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    ValueChanged="OnGlassOpacityChanged"
                                    Margin="0,0,0,12" />

                            <!-- Blur Intensity Slider (Windows DWM Acrylic / Frosted Blur) -->
                            <Grid Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Blur Effect &amp; Intensity:" Foreground="#F4F4F5" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text=" (Frosted Glass Acrylic)" Foreground="#71717A" FontSize="11" Margin="4,1,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="TxtBlurValue" Text="85% Frosted Blur" Foreground="#0A84FF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="SliderBlurIntensity"
                                    Minimum="0.0" Maximum="1.0" Value="0.85"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    ValueChanged="OnBlurIntensityChanged"
                                    Margin="0,0,0,12" />

                            <!-- 2. Border Radius Slider -->
                            <Grid Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Border Radius:" Foreground="#F4F4F5" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text=" (Square 0px ←→ Full Pill 40px)" Foreground="#71717A" FontSize="11" Margin="4,1,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="TxtRadiusValue" Text="28px" Foreground="#0A84FF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="SliderBorderRadius"
                                    Minimum="0" Maximum="40" Value="28"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="OnBorderRadiusChanged"
                                    Margin="0,0,0,12" />

                            <!-- Auto System Theme Adaptation -->
                            <CheckBox x:Name="ChkAutoTheme" Style="{StaticResource ModernToggle}"
                                      Content="Auto-adapt to Windows Theme (Dark Glass / Light Glass)" />
                            <TextBlock Text="Dynamically switches dock glass between Dark Glass and Light Glass based on Windows system theme."
                                       Foreground="#71717A" FontSize="10" Margin="24,-2,0,10" />

                            <!-- 3. Dock Tint Palette -->
                            <TextBlock Text="Background Tint" Foreground="#F4F4F5" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button Click="OnTintSlateClicked" Background="#22222A" BorderBrush="#33333F" BorderThickness="1" Foreground="#F4F4F5" Padding="10,5" FontSize="11" Margin="0,0,6,0" Style="{StaticResource ActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="#4B5563" Margin="0,0,6,0" />
                                        <TextBlock Text="Slate Gray" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnTintCharcoalClicked" Background="#181820" BorderBrush="#2A2A34" BorderThickness="1" Foreground="#F4F4F5" Padding="10,5" FontSize="11" Margin="0,0,6,0" Style="{StaticResource ActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="#27272A" Margin="0,0,6,0" />
                                        <TextBlock Text="Dark Charcoal" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnTintOledClicked" Background="#0E0E12" BorderBrush="#22222A" BorderThickness="1" Foreground="#F4F4F5" Padding="10,5" FontSize="11" Margin="0,0,6,0" Style="{StaticResource ActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="#0A0A0C" Margin="0,0,6,0" />
                                        <TextBlock Text="OLED Black" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnTintMidnightClicked" Background="#10121C" BorderBrush="#222638" BorderThickness="1" Foreground="#F4F4F5" Padding="10,5" FontSize="11" Style="{StaticResource ActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="#1E293B" Margin="0,0,6,0" />
                                        <TextBlock Text="Midnight" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Section: Taskbar & Screen Integration -->
                    <TextBlock Text="TASKBAR &amp; SCREEN INTEGRATION" Foreground="#A1A1AA" FontSize="11" FontWeight="Bold" Margin="0,2,0,8" />

                    <Border Background="#16161C" BorderBrush="#22222A" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="ChkLaunchAtStartup" Style="{StaticResource ModernToggle}"
                                      Content="Start WinDock automatically with Windows (System Startup)" />
                            <TextBlock Text="Launches WinDock seamlessly whenever you turn on or log into your PC."
                                       Foreground="#71717A" FontSize="10" Margin="24,-2,0,6" />

                            <CheckBox x:Name="ChkHideTaskbar" Style="{StaticResource ModernToggle}"
                                      Content="Hide Windows Taskbar automatically when WinDock runs" />
                            <TextBlock Text="Replaces Windows taskbar with WinDock. Restores automatically when WinDock exits."
                                       Foreground="#71717A" FontSize="10" Margin="24,-2,0,6" />

                            <CheckBox x:Name="ChkReserveSpace" Style="{StaticResource ModernToggle}"
                                      Content="Reserve Screen Space (AppBar Mode)" />
                            <TextBlock Text="Prevents maximized windows from overlapping the dock."
                                       Foreground="#71717A" FontSize="10" Margin="24,-2,0,6" />

                            <CheckBox x:Name="ChkAutoHide" Style="{StaticResource ModernToggle}"
                                      Content="Auto-hide Dock when mouse leaves screen bottom" />
                            <TextBlock Text="Dock smoothly slides down and reveals when cursor touches the bottom edge."
                                       Foreground="#71717A" FontSize="10" Margin="24,-2,0,2" />
                        </StackPanel>
                    </Border>

                    <!-- Section: Dynamic Drop Notch Shelf -->
                    <TextBlock Text="DYNAMIC DROP NOTCH (TOP SHELF)" Foreground="#A1A1AA" FontSize="11" FontWeight="Bold" Margin="0,2,0,8" />

                    <Border Background="#16161C" BorderBrush="#22222A" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="ChkEnableNotch" Style="{StaticResource ModernToggle}"
                                      Content="Enable Dynamic Drop Notch at top of screen" />
                            <TextBlock Text="Top-screen notch shelf: drag files/links in to hold temporarily, and drag out into any app."
                                       Foreground="#71717A" FontSize="10" Margin="24,-2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Section: Magnification & Size -->
                    <TextBlock Text="HOVER ZOOM &amp; SIZING" Foreground="#A1A1AA" FontSize="11" FontWeight="Bold" Margin="0,2,0,8" />

                    <Border Background="#16161C" BorderBrush="#22222A" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Hover Zoom Magnification" Foreground="#F4F4F5" FontSize="12" />
                                <TextBlock x:Name="TxtMagValue" Text="1.35x" Foreground="#0A84FF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="SliderMagnification" Minimum="1.0" Maximum="1.8" Value="1.35"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    ValueChanged="OnMagnificationChanged" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Dock Icon Size" Foreground="#F4F4F5" FontSize="12" />
                                <TextBlock x:Name="TxtIconSizeValue" Text="52px" Foreground="#0A84FF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider x:Name="SliderIconSize" Minimum="36" Maximum="72" Value="52"
                                    TickFrequency="2" IsSnapToTickEnabled="True"
                                    ValueChanged="OnIconSizeChanged" />
                        </StackPanel>
                    </Border>

                    <!-- Section: Customizable Shortcuts -->
                    <TextBlock Text="GLOBAL KEYBOARD SHORTCUTS" Foreground="#A1A1AA" FontSize="11" FontWeight="Bold" Margin="0,2,0,8" />

                    <Border Background="#16161C" BorderBrush="#22222A" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Spotlight Search Shortcut" Foreground="#F4F4F5" FontSize="12" />
                                    <TextBlock Text="Opens MacBook-style Spotlight search &amp; calculator" Foreground="#71717A" FontSize="10" />
                                </StackPanel>
                                <ComboBox x:Name="ComboSpotlightKey" HorizontalAlignment="Right" Width="170" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Alt+Space (Default)" Tag="Alt+Space" />
                                    <ComboBoxItem Content="Ctrl+Space" Tag="Ctrl+Space" />
                                    <ComboBoxItem Content="Win+Space" Tag="Win+Space" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,0,0,2">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Toggle Taskbar Shortcut" Foreground="#F4F4F5" FontSize="12" />
                                    <TextBlock Text="Shows or hides Windows native taskbar" Foreground="#71717A" FontSize="10" />
                                </StackPanel>
                                <ComboBox x:Name="ComboTaskbarKey" HorizontalAlignment="Right" Width="170" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Win+Alt+D (Default)" Tag="Win+Alt+D" />
                                    <ComboBoxItem Content="Ctrl+Alt+T" Tag="Ctrl+Alt+T" />
                                    <ComboBoxItem Content="Win+Shift+T" Tag="Win+Shift+T" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Section: Emergency Taskbar Recovery -->
                    <TextBlock Text="EMERGENCY TASKBAR RESTORE" Foreground="#EF4444" FontSize="11" FontWeight="Bold" Margin="0,2,0,8" />

                    <Border Background="#251214" BorderBrush="#50EF4444" BorderThickness="1" CornerRadius="10" Padding="14,10">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Force Restore Windows Taskbar" Foreground="#FCA5A5" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="Instantly restores Shell_TrayWnd to visible." Foreground="#FCA5A5" FontSize="10" />
                            </StackPanel>
                            <Button Content="Restore Now" Click="OnEmergencyRestoreClicked"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#EF4444" Foreground="White" Padding="10,5" FontSize="11"
                                    Style="{StaticResource ActionButtonStyle}" />
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Buttons -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock x:Name="TxtSaveStatus" Text="✓ Settings saved &amp; applied" Foreground="#4ADE80" FontSize="11" FontWeight="SemiBold"
                               Visibility="Collapsed" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Exit WinDock" Click="OnExitWinDockClicked" Background="#351518" BorderBrush="#55EF4444" BorderThickness="1" Foreground="#FCA5A5" Style="{StaticResource ActionButtonStyle}" Margin="0,0,12,0" />
                    <Button Content="Close" Click="OnCloseClicked" Background="#202026" BorderBrush="#2C2C36" BorderThickness="1" Foreground="#D4D4D8" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                    <Button x:Name="BtnSave" Content="Save &amp; Apply" Click="OnSaveClicked" Style="{StaticResource ActionButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
