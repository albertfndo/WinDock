<Window x:Class="WinDock.Views.AppListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:WinDock.Converters"
        mc:Ignorable="d"
        Title="WinDock App Launcher &amp; Power Menu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="700"
        Height="540"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Deactivated="OnWindowDeactivated">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Power Action Button Style -->
        <Style x:Key="PowerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#20FFFFFF" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pBorder" Property="Background" Value="#35FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pBorder" Property="Background" Value="#50FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container -->
    <Border Background="#F40F172A"
            BorderBrush="#38455C"
            BorderThickness="1"
            CornerRadius="18"
            Padding="20,16">

        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.75" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Top Header: User Profile & Search Box -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- User Profile Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Width="34" Height="34" CornerRadius="17" Background="#2563EB" Margin="0,0,10,0">
                        <TextBlock x:Name="UserInitialText" Text="U" Foreground="White" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UserNameText" Text="User" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold" />
                        <TextBlock Text="Applications" Foreground="#94A3B8" FontSize="10" />
                    </StackPanel>
                </StackPanel>

                <!-- Search Input Box -->
                <Border Grid.Column="1"
                        Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,6"
                        Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center" />

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#F8FAFC"
                                 CaretBrush="#38BDF8"
                                 FontSize="13"
                                 VerticalAlignment="Center"
                                 TextChanged="OnSearchTextChanged" />

                        <TextBlock x:Name="SearchPlaceholder"
                                   Grid.Column="1"
                                   Text="Type to search apps..."
                                   Foreground="#64748B"
                                   FontSize="13"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Close Button -->
                <Button Grid.Column="2"
                        Content="✕"
                        Click="OnCloseClicked"
                        Background="Transparent"
                        Foreground="#94A3B8"
                        BorderThickness="0"
                        FontSize="15"
                        Cursor="Hand"
                        VerticalAlignment="Center" />
            </Grid>

            <!-- 2. Application Grid Area -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,12">
                <ItemsControl x:Name="AppsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- App Tile -->
                            <Border Width="100" Height="90" Margin="4,4"
                                    Background="Transparent"
                                    CornerRadius="12"
                                    Padding="6,8"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnAppClicked"
                                    MouseRightButtonUp="OnAppRightClicked">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#25FFFFFF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- App Icon -->
                                    <Grid Grid.Row="0" Width="44" Height="44" HorizontalAlignment="Center">
                                        <Image Source="{Binding Icon}"
                                               Visibility="{Binding Icon, Converter={StaticResource NullToVis}}"
                                               Width="40" Height="40"
                                               RenderOptions.BitmapScalingMode="HighQuality" />

                                        <!-- Fallback placeholder -->
                                        <Border Visibility="{Binding Icon, Converter={StaticResource NullToVis}, ConverterParameter=invert}"
                                                Background="#2563EB" CornerRadius="10">
                                            <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- App Title -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Title}"
                                               Foreground="#F1F5F9"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Separator -->
            <Rectangle Grid.Row="2" Fill="#20FFFFFF" Height="1" Margin="0,0,0,12" />

            <!-- 3. Bottom Action Bar (Settings, Desktop, Power) -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Quick Actions: Settings & Desktop -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PowerButtonStyle}"
                            Click="OnSettingsClicked"
                            ToolTip="Open WinDock Settings"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="12" Margin="0,0,5,0" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PowerButtonStyle}"
                            Click="OnDesktopClicked"
                            ToolTip="Show Desktop (Kembali ke Desktop)"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖥" FontSize="11" Margin="0,0,5,0" />
                            <TextBlock Text="Desktop" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PowerButtonStyle}"
                            Click="OnNotchClicked"
                            ToolTip="Toggle Dynamic Drop Notch Shelf"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☁" FontSize="11" Margin="0,0,5,0" />
                            <TextBlock Text="Notch" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right Power Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Lock Screen -->
                    <Button Style="{StaticResource PowerButtonStyle}"
                            Click="OnLockClicked"
                            ToolTip="Lock Windows Workstation"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔒" FontSize="11" Margin="0,0,4,0" />
                            <TextBlock Text="Lock" />
                        </StackPanel>
                    </Button>

                    <!-- Sleep Mode -->
                    <Button Style="{StaticResource PowerButtonStyle}"
                            Click="OnSleepClicked"
                            ToolTip="Put Windows to Sleep (Suspend)"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌙" FontSize="11" Margin="0,0,4,0" />
                            <TextBlock Text="Sleep" />
                        </StackPanel>
                    </Button>

                    <!-- Restart PC -->
                    <Button Style="{StaticResource PowerButtonStyle}"
                            Click="OnRestartClicked"
                            ToolTip="Restart Windows Computer"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="11" Margin="0,0,4,0" />
                            <TextBlock Text="Restart" />
                        </StackPanel>
                    </Button>

                    <!-- Shutdown PC -->
                    <Button Style="{StaticResource PowerButtonStyle}"
                            Click="OnShutdownClicked"
                            Background="#30EF4444"
                            BorderBrush="#50EF4444"
                            Foreground="#FCA5A5"
                            ToolTip="Shut Down Windows Computer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏻" FontSize="11" FontWeight="Bold" Margin="0,0,4,0" />
                            <TextBlock Text="Shut Down" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
