<Window x:Class="WinDock.Views.AppListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:WinDock.Converters"
        mc:Ignorable="d"
        Title="WinDock Launchpad"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0B0B10"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        MouseWheel="OnWindowMouseWheel"
        Deactivated="OnWindowDeactivated">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- App tile: a real Button so Tab/Enter work, macOS Launchpad proportions -->
        <Style x:Key="AppTileStyle" TargetType="Button">
            <Setter Property="Width" Value="128" />
            <Setter Property="Height" Value="128" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="tileRoot" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Border x:Name="focusRing" CornerRadius="22" Margin="14,2,14,26"
                                    BorderBrush="#CCFFFFFF" BorderThickness="0" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="focusRing" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="tileRoot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round glass icon button for the corner actions -->
        <Style x:Key="CornerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="20" Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="#CCFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CornerGlyph" TargetType="Path">
            <Setter Property="Fill" Value="#F2FFFFFF" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>

        <Style x:Key="MenuGlyph" TargetType="Path">
            <Setter Property="Fill" Value="#E6FFFFFF" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>

        <!-- Power menu: dark glass -->
        <Style x:Key="PowerContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="#F5FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#F2202024" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Padding="5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" Color="#000000" Opacity="0.5" Direction="270" ShadowDepth="6" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PowerMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F5FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="mBorder" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="mBorder" Property="Background" Value="#0A84FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PowerMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Fill="#26FFFFFF" Margin="8,4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Backdrop: blurred wallpaper, dimmed (macOS Launchpad). Click empty space to close. -->
        <Grid x:Name="Backdrop" ClipToBounds="True" MouseLeftButtonUp="OnBackdropClicked" Background="#0B0B10">
            <!-- Blur is static: cache it as a bitmap so page/opening animations don't re-run the shader -->
            <Grid.CacheMode>
                <BitmapCache RenderAtScale="1" />
            </Grid.CacheMode>
            <Image x:Name="WallpaperImage" Stretch="UniformToFill" Margin="-60">
                <Image.Effect>
                    <BlurEffect Radius="60" KernelType="Gaussian" RenderingBias="Performance" />
                </Image.Effect>
            </Image>
            <Rectangle Fill="#80000000" />
        </Grid>

        <!-- Content, animated in on open -->
        <Grid x:Name="ContentRoot" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="ContentScale" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search field, centered -->
            <Border Grid.Row="0" Width="260" Height="34" Margin="0,48,0,0"
                    HorizontalAlignment="Center" CornerRadius="9"
                    Background="#33FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                          Fill="#CCFFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox" Grid.Column="1"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#FFFFFF" CaretBrush="#FFFFFF" SelectionBrush="#0A84FF"
                             FontSize="14" VerticalAlignment="Center"
                             TextChanged="OnSearchTextChanged" />
                    <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="Search"
                               Foreground="#B3FFFFFF" FontSize="14" IsHitTestVisible="False" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Corner actions -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,40,0">
                <Button Style="{StaticResource CornerButtonStyle}" Click="OnSettingsClicked" ToolTip="WinDock Settings">
                    <Path Style="{StaticResource CornerGlyph}" Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.488.488 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" />
                </Button>
                <Button Style="{StaticResource CornerButtonStyle}" Click="OnNotchClicked" ToolTip="Show / Hide Drop Shelf">
                    <Path Style="{StaticResource CornerGlyph}" Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z" />
                </Button>
                <Button Style="{StaticResource CornerButtonStyle}" Click="OnHelpClicked" ToolTip="Shortcuts (F1)">
                    <Path Style="{StaticResource CornerGlyph}" Data="M11 18h2v-2h-2v2zm1-16C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-2.21 0-4 1.79-4 4h2c0-1.1.9-2 2-2s2 .9 2 2c0 2-3 1.75-3 5h2c0-2.25 3-2.5 3-5 0-2.21-1.79-4-4-4z" />
                </Button>
                <Button x:Name="BtnPower" Style="{StaticResource CornerButtonStyle}" Click="OnPowerDropdownClicked" ToolTip="Lock, Sleep, Restart, Shut Down">
                    <Path Style="{StaticResource CornerGlyph}" Data="M13 3h-2v10h2V3zm4.83 2.17l-1.42 1.42A6.92 6.92 0 0 1 19 12c0 3.87-3.13 7-7 7A6.995 6.995 0 0 1 7.58 6.58L6.17 5.17A8.932 8.932 0 0 0 3 12a9 9 0 0 0 18 0c0-2.74-1.23-5.18-3.17-6.83z" />
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource PowerContextMenuStyle}">
                            <MenuItem Header="Lock" Click="OnLockClicked" Style="{StaticResource PowerMenuItemStyle}">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource MenuGlyph}" Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Sleep" Click="OnSleepClicked" Style="{StaticResource PowerMenuItemStyle}">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource MenuGlyph}" Data="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Restart…" Click="OnRestartClicked" Style="{StaticResource PowerMenuItemStyle}">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource MenuGlyph}" Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Shut Down…" Click="OnShutdownClicked" Style="{StaticResource PowerMenuItemStyle}">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource MenuGlyph}" Data="M13 3h-2v10h2V3zm4.83 2.17l-1.42 1.42A6.92 6.92 0 0 1 19 12c0 3.87-3.13 7-7 7A6.995 6.995 0 0 1 7.58 6.58L6.17 5.17A8.932 8.932 0 0 0 3 12a9 9 0 0 0 18 0c0-2.74-1.23-5.18-3.17-6.83z" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator Style="{StaticResource PowerMenuSeparatorStyle}" />
                            <MenuItem Header="Quit WinDock" Click="OnExitWinDockClicked" Style="{StaticResource PowerMenuItemStyle}">
                                <MenuItem.Icon>
                                    <Path Style="{StaticResource MenuGlyph}" Data="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5a2 2 0 0 0-2 2v4h2V5h14v14H5v-4H3v4a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>

            <!-- App grid (one page at a time) -->
            <ItemsControl x:Name="AppsItemsControl" Grid.Row="1"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          KeyboardNavigation.TabNavigation="Cycle">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource AppTileStyle}"
                                Click="OnAppClicked"
                                MouseRightButtonUp="OnAppRightClicked"
                                ToolTip="{Binding Title}">
                            <StackPanel VerticalAlignment="Top" Margin="0,6,0,0">
                                <Grid Width="80" Height="80" HorizontalAlignment="Center">
                                    <Image Source="{Binding Icon}"
                                           Visibility="{Binding Icon, Converter={StaticResource NullToVis}}"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           RenderOptions.EdgeMode="Aliased"
                                           SnapsToDevicePixels="True"
                                           UseLayoutRounding="True"
                                           Width="80" Height="80" />
                                    <!-- No icon: monogram tile -->
                                    <Border Visibility="{Binding Icon, Converter={StaticResource NullToVis}, ConverterParameter=invert}"
                                            CornerRadius="18" Background="#3A3A44">
                                        <TextBlock Text="{Binding Title, Converter={x:Static conv:FirstLetterConverter.Instance}}"
                                                   Foreground="#FFFFFF" FontSize="32" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="#FFFFFF" FontSize="12.5"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           MaxWidth="116" Margin="0,8,0,0" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty search result -->
            <TextBlock x:Name="NoResultsText" Grid.Row="1" Visibility="Collapsed"
                       Foreground="#CCFFFFFF" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- Page dots; leaves room for the dock below -->
            <StackPanel x:Name="PageDots" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,130" />
        </Grid>
    </Grid>
</Window>
