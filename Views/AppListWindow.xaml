<Window x:Class="WinDock.Views.AppListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:WinDock.Converters"
        mc:Ignorable="d"
        Title="WinDock App Launcher &amp; Power Menu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="700"
        Height="540"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Deactivated="OnWindowDeactivated">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVis" />

        <!-- Power Action Button Style -->
        <Style x:Key="PowerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#20FFFFFF" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pBorder" Property="Background" Value="#35FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pBorder" Property="Background" Value="#50FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Glass Power Context Menu Style -->
        <Style x:Key="PowerContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#F81E293B" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" Color="#000000" Opacity="0.75" Direction="270" ShadowDepth="4" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PowerMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="mBorder"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Margin="2,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="mBorder" Property="Background" Value="#2563EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PowerMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Background" Value="#25FFFFFF" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Height" Value="1" />
        </Style>
    </Window.Resources>

    <!-- Main Container -->
    <Border CornerRadius="20" Padding="20,16">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F00F172A" Offset="0.0" />
                <GradientStop Color="#F8080C16" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#45FFFFFF" Offset="0.0" />
                <GradientStop Color="#18FFFFFF" Offset="1.0" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.BorderThickness>1</Border.BorderThickness>

        <Border.Effect>
            <DropShadowEffect BlurRadius="42" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.7" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Top Header: User Profile & Search Box -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- User Profile Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B82F6" Offset="0.0" />
                                <GradientStop Color="#8B5CF6" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock x:Name="UserInitialText" Text="U" Foreground="White" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UserNameText" Text="User" Foreground="#F8FAFC" FontSize="13.5" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" />
                        <TextBlock Text="WinDock Launchpad" Foreground="#94A3B8" FontSize="10.5" />
                    </StackPanel>
                </StackPanel>

                <!-- Search Input Box -->
                <Border Grid.Column="1"
                        Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,6"
                        Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center" />

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#F8FAFC"
                                 CaretBrush="#38BDF8"
                                 FontSize="13"
                                 VerticalAlignment="Center"
                                 TextChanged="OnSearchTextChanged" />

                        <TextBlock x:Name="SearchPlaceholder"
                                   Grid.Column="1"
                                   Text="Type to search apps..."
                                   Foreground="#64748B"
                                   FontSize="13"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Close Button -->
                <Button Grid.Column="2"
                        Content="✕"
                        Click="OnCloseClicked"
                        Background="Transparent"
                        Foreground="#94A3B8"
                        BorderThickness="0"
                        FontSize="15"
                        Cursor="Hand"
                        VerticalAlignment="Center" />
            </Grid>

            <!-- 2. Application Grid Area -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,12">
                <ItemsControl x:Name="AppsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- App Tile -->
                            <Border Width="104" Height="92" Margin="4,4"
                                    Background="Transparent"
                                    CornerRadius="14"
                                    Padding="6,8"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnAppClicked"
                                    MouseRightButtonUp="OnAppRightClicked">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#25FFFFFF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- App Icon -->
                                    <Grid Grid.Row="0" Width="44" Height="44" HorizontalAlignment="Center">
                                        <Image Source="{Binding Icon}"
                                               Visibility="{Binding Icon, Converter={StaticResource NullToVis}}"
                                               Width="40" Height="40"
                                               RenderOptions.BitmapScalingMode="HighQuality" />

                                        <!-- Fallback placeholder -->
                                        <Border Visibility="{Binding Icon, Converter={StaticResource NullToVis}, ConverterParameter=invert}"
                                                Background="#2563EB" CornerRadius="10">
                                            <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- App Title -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Title}"
                                               Foreground="#F1F5F9"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Separator -->
            <Rectangle Grid.Row="2" Fill="#20FFFFFF" Height="1" Margin="0,0,0,12" />

            <!-- 3. Bottom Action Bar (Settings, Desktop, Power) -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Quick Actions: Settings & Desktop -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PowerButtonStyle}"
                            Click="OnSettingsClicked"
                            ToolTip="Open WinDock Settings"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="12" Margin="0,0,5,0" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PowerButtonStyle}"
                            Click="OnDesktopClicked"
                            ToolTip="Show Desktop (Kembali ke Desktop)"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖥" FontSize="11" Margin="0,0,5,0" />
                            <TextBlock Text="Desktop" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PowerButtonStyle}"
                            Click="OnNotchClicked"
                            ToolTip="Toggle Dynamic Drop Notch Shelf"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☁" FontSize="11" Margin="0,0,5,0" />
                            <TextBlock Text="Notch" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: Unified Power Dropdown Button (Sleep, Lock, Restart, Shut Down) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnPowerDropdown"
                            Style="{StaticResource PowerButtonStyle}"
                            Click="OnPowerDropdownClicked"
                            ToolTip="Power Options (Sleep, Lock, Restart, Shut Down)"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⏻" FontSize="12.5" Foreground="#F87171" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Power" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text=" ▴" FontSize="8.5" Foreground="#94A3B8" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="PowerContextMenu"
                                         Style="{StaticResource PowerContextMenuStyle}"
                                         Placement="Top">
                                <MenuItem Header="Lock Screen" Click="OnLockClicked" Style="{StaticResource PowerMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="🔒" FontSize="13" VerticalAlignment="Center" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Sleep" Click="OnSleepClicked" Style="{StaticResource PowerMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="🌙" FontSize="13" VerticalAlignment="Center" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Restart..." Click="OnRestartClicked" Style="{StaticResource PowerMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="🔄" FontSize="13" VerticalAlignment="Center" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Style="{StaticResource PowerMenuSeparatorStyle}" />
                                <MenuItem Header="Shut Down..." Click="OnShutdownClicked" Style="{StaticResource PowerMenuItemStyle}" Foreground="#FCA5A5">
                                    <MenuItem.Icon>
                                        <TextBlock Text="⏻" FontSize="13" Foreground="#EF4444" FontWeight="Bold" VerticalAlignment="Center" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Style="{StaticResource PowerMenuSeparatorStyle}" />
                                <MenuItem Header="Exit WinDock" Click="OnExitWinDockClicked" Style="{StaticResource PowerMenuItemStyle}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="✕" FontSize="11" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
