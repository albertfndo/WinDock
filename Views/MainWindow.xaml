<Window x:Class="WinDock.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:WinDock.Converters"
        mc:Ignorable="d"
        Title="WinDock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        AllowDrop="True"
        DragEnter="OnDockDragEnter"
        DragOver="OnDockDragOver"
        Drop="OnDockDrop">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" />
        <conv:GreaterThanZeroToVisibilityConverter x:Key="MultiCountToVis" />
        <conv:DoubleToCornerRadiusConverter x:Key="RadiusConverter" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="BadgeVisConverter" />

        <!-- Dock foreground tokens: replaced in ApplyAppearance for light tints -->
        <SolidColorBrush x:Key="DockGlyph" Color="#E6FFFFFF" />
        <SolidColorBrush x:Key="DockText" Color="#F5FFFFFF" />
        <SolidColorBrush x:Key="DockTextMuted" Color="#B3FFFFFF" />

        <!-- Authentic Frosted Glass Vertical Etched Divider Brush -->
        <LinearGradientBrush x:Key="DockDividerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00FFFFFF" Offset="0.0" />
            <GradientStop Color="#50FFFFFF" Offset="0.5" />
            <GradientStop Color="#00FFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Tooltip Style -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#E60F172A" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#000000" Opacity="0.4" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Dock Button (Zero padding/margins, transparent background, matches DockItem) -->
        <Style x:Key="CleanDockButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- System Button Style -->
        <Style x:Key="TrayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#25FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reusable Dock Item Template for Pinned & Running Apps -->
        <DataTemplate x:Key="DockItemTemplate">
            <Grid Width="{Binding ItemWidth}" Height="{Binding ItemHeight}" Margin="3,0,3,0"
                  Cursor="Hand"
                  MouseEnter="OnDockItemMouseEnter"
                  MouseLeave="OnDockItemMouseLeave"
                  PreviewMouseLeftButtonDown="OnDockItemPreviewMouseDown"
                  PreviewMouseMove="OnDockItemPreviewMouseMove"
                  MouseLeftButtonUp="OnItemClick"
                  MouseRightButtonUp="OnItemRightClick"
                  AllowDrop="True"
                  DragOver="OnDockItemDragOver"
                  Drop="OnDockItemDrop"
                  Background="Transparent">

                <!-- Fluid Upward Magnification -->
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                </Grid.RenderTransform>
                <Grid.RenderTransformOrigin>
                    <Point X="0.5" Y="0.85" />
                </Grid.RenderTransformOrigin>

                <!-- Icon and Badge Grid -->
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,5">
                    <!-- Crisp High-Resolution Icon -->
                    <Image Source="{Binding Icon}"
                           Width="{Binding IconSize}"
                           Height="{Binding IconSize}"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           RenderOptions.EdgeMode="Aliased"
                           SnapsToDevicePixels="True"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    </Image>

                    <!-- Red Notification / Window Count Badge -->
                    <Border Visibility="{Binding BadgeText, Converter={StaticResource BadgeVisConverter}}"
                            Background="#FF3B30"
                            CornerRadius="10"
                            MinWidth="20"
                            Height="20"
                            Padding="5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-5,-7,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.4" />
                        </Border.Effect>
                        <TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Running Indicator Dot -->
                <Border Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                        Width="4"
                        Height="4"
                        CornerRadius="2"
                        Background="{DynamicResource DockTextMuted}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,3" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" VerticalAlignment="Center" HorizontalAlignment="Center">
        <!-- Floating Dock Bar -->
        <Border x:Name="DockBar"
                Height="80"
                CornerRadius="28"
                BorderThickness="1"
                BorderBrush="#40FFFFFF"
                Padding="14,6,14,9"
                HorizontalAlignment="Center"
                ClipToBounds="False"
                MouseEnter="OnDockMouseEnter"
                MouseLeave="OnDockMouseLeave">

            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.28" />
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- 1. Launchpad tile (WinDock Start Menu). Sized to IconSize in ApplyAppearance. -->
                <Button Style="{StaticResource CleanDockButtonStyle}"
                        Click="OnStartButtonClicked"
                        MouseEnter="OnLaunchpadMouseEnter"
                        MouseLeave="OnSpecialTileMouseLeave"
                        Margin="3,0,3,0">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,5">
                        <Border x:Name="LaunchpadTile" Width="52" Height="52" CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#5E5CE6" Offset="0" />
                                    <GradientStop Color="#2C2A8F" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <!-- 3x3 app grid glyph -->
                            <UniformGrid Rows="3" Columns="3" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="5" Height="5" Fill="#FFFFFF" Margin="1" />
                                <Ellipse Width="5" Height="5" Fill="#FFFFFF" Margin="1" />
                                <Ellipse Width="5" Height="5" Fill="#FFFFFF" Margin="1" />
                                <Ellipse Width="5" Height="5" Fill="#FFFFFF" Margin="1" />
                                <Ellipse Width="5" Height="5" Fill="#FFFFFF" Margin="1" />
                                <Ellipse Width="5" Height="5" Fill="#FFFFFF" Margin="1" />
                                <Ellipse Width="5" Height="5" Fill="#FFFFFF" Margin="1" />
                                <Ellipse Width="5" Height="5" Fill="#FFFFFF" Margin="1" />
                                <Ellipse Width="5" Height="5" Fill="#FFFFFF" Margin="1" />
                            </UniformGrid>
                        </Border>
                    </Grid>
                </Button>

                <!-- 2. Pinned Application Icons -->
                <ItemsControl x:Name="PinnedItemsControl"
                              ItemTemplate="{StaticResource DockItemTemplate}"
                              PreviewMouseMove="OnDockItemsMouseMove">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Divider between Pinned Apps and Running Apps -->
                <Rectangle x:Name="RunningDivider"
                           Width="1" Height="24" Fill="{StaticResource DockDividerBrush}" Margin="6,0,6,0"
                           VerticalAlignment="Center" />

                <!-- 3. Running (Unpinned) Application Icons -->
                <ItemsControl x:Name="RunningItemsControl"
                              ItemTemplate="{StaticResource DockItemTemplate}"
                              PreviewMouseMove="OnDockItemsMouseMove">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Divider before Downloads & Trash (macOS-style right section) -->
                <Rectangle Width="1" Height="24" Fill="{StaticResource DockDividerBrush}" Margin="6,0,6,0" VerticalAlignment="Center" />

                <!-- 4. Downloads Stack (macOS style next to Trash) -->
                <Button x:Name="DownloadsButton"
                        Style="{StaticResource CleanDockButtonStyle}"
                        Click="OnDownloadsClicked"
                        MouseEnter="OnDownloadsMouseEnter"
                        MouseLeave="OnSpecialTileMouseLeave"
                        Margin="3,0,3,0"
                        AllowDrop="True"
                        DragEnter="OnDownloadsDragEnter"
                        DragOver="OnDownloadsDragOver"
                        DragLeave="OnDownloadsDragLeave"
                        Drop="OnDownloadsDrop">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,5">
                        <Border x:Name="DownloadsTile" Width="52" Height="52" CornerRadius="12" Background="#1AFFFFFF">
                            <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"
                                  Fill="{DynamicResource DockGlyph}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>

                <!-- 5. Recycle Bin (Trash) with Drag & Drop support -->
                <Button x:Name="TrashButton"
                        Style="{StaticResource CleanDockButtonStyle}"
                        Click="OnRecycleBinClicked"
                        MouseEnter="OnTrashMouseEnter"
                        MouseLeave="OnSpecialTileMouseLeave"
                        Margin="3,0,3,0"
                        AllowDrop="True"
                        DragEnter="OnTrashDragEnter"
                        DragOver="OnTrashDragOver"
                        DragLeave="OnTrashDragLeave"
                        Drop="OnTrashDrop">
                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,5">
                        <Border x:Name="TrashTile" Width="52" Height="52" CornerRadius="12" Background="#1AFFFFFF">
                            <Path x:Name="TrashGlyph" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                  Fill="{DynamicResource DockGlyph}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Button>

            </StackPanel>
        </Border>

        <!-- macOS Floating Tooltip Bubble (Popup so it doesn't force extra HWND space or blur rectangle) -->
        <Popup x:Name="MacTooltipPopup"
               PlacementTarget="{Binding ElementName=DockBar}"
               Placement="Top"
               AllowsTransparency="True"
               IsOpen="False">
            <Border x:Name="MacTooltipBubble"
                    Background="#E60F172A"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,4"
                    Margin="0,0,0,6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.5" />
                </Border.Effect>
                <TextBlock x:Name="MacTooltipText"
                           Text="App Title"
                           Foreground="#F8FAFC"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" />
            </Border>
        </Popup>
    </Grid>
</Window>
